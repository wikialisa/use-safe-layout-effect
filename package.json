{
  "name": "@wikialisa/use-safe-layout-effect",
  "version": "1.0.0",
  "description": "Thư viện tài sản @wikialisa/use-safe-layout-effect được chuyển đổi sang thương hiệu Wikialisa.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "dependencies": {},
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
